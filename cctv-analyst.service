[Unit]
Description=RasPi CCTV Analyst
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/raspi-cctv-analyst
ExecStart=/home/pi/raspi-cctv-analyst/venv/bin/python -m uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 5000 \
    --workers 1 \
    --ssl-keyfile ssl/key.pem \
    --ssl-certfile ssl/cert.pem
MemoryMax=1400M
CPUQuota=360%
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
